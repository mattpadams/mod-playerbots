# LLM Provider (claude = Claude Agent SDK with OAuth from host)
LLM_PROVIDER=claude
# LLM_MODEL=claude-sonnet-4-6  # Optional override; leave empty for provider default

# Claude Code credentials path on host (run `claude login` first)
# CLAUDE_CREDENTIALS_PATH=~/.claude/.credentials.json

# Game server connection
WS_HOST=ac-worldserver
WS_CMD_PORT=8888
WS_SOAP_PORT=7878
SOAP_USER=admin
SOAP_PASS=admin

# Database
DB_HOST=ac-database
DB_PORT=3306
DB_USER=root
DB_PASS=password
DB_PLAYERBOTS=acore_playerbots
DB_CHARACTERS=acore_characters

# Qdrant
QDRANT_HOST=ac-qdrant
QDRANT_PORT=6333

# Agent settings
MAX_ACTIVE_AGENTS=50
AGENT_TICK_SECONDS=3
MAX_HOURLY_SPEND_USD=5.00

# Model routing
MODEL_DEFAULT=claude-haiku-4-5
MODEL_IMPORTANT=claude-sonnet-4-6
